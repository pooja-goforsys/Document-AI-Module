# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/docai

# ── AI Provider  (gemini | openai | anthropic | local) ───────────────────────
# Choose ONE primary provider.  Others serve as automatic fallbacks.
AI_PROVIDER=gemini

# --- Gemini (Google AI Studio) ------------------------------------------------
# Get a FREE key at: https://aistudio.google.com/app/apikey
# Valid keys ALWAYS start with "AIzaSy" (39 chars).
# Keys starting with "AQ.", "ya29.", or similar are NOT AI Studio keys and WILL fail.
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_ACTUAL_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (optional fallback) -----------------------------------------------
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (optional fallback) -------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Local model via Ollama / LM Studio / vLLM (optional fallback) -----------
# LOCAL_MODEL_ENDPOINT=http://localhost:11434
# LOCAL_MODEL_NAME=llama3.2

# ── Embedding Provider  (huggingface | gemini | openai) ───────────────────────
EMBEDDING_PROVIDER=huggingface

# Embedding model + matching dimension — THESE TWO MUST MATCH.
# Changing model requires full re-index of all documents.
#
#   Model                                    Dim   Notes
#   sentence-transformers/all-MiniLM-L6-v2   384   Fast, low RAM (default)
#   sentence-transformers/all-mpnet-base-v2  768   Better quality
#   BAAI/bge-large-en-v1.5                  1024   Best for enterprise docs
#   text-embedding-3-small (OpenAI)         1536   Cloud, requires OPENAI_API_KEY
#
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── RAG Settings ──────────────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.65     # cosine distance cutoff (≤ 0.65 → similarity ≥ 0.35)
TOP_K_CHUNKS=5                # chunks sent to LLM per query
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── Auth / JWT ────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-A-LONG-RANDOM-SECRET-KEY-MIN-32-CHARS

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
